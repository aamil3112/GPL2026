# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (only enforced when NODE_ENV=production)
CORS_ORIGINS=https://example.com,https://www.example.com

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Hardcoded single admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
